{
  "name": "agendamix",
  "version": "1.0.0",
  "description": "AgendaMix - Plataforma de Agendamento Online para Beleza & Estética",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "sync:dump": "npm --prefix backend run sync:dump",
    "build": "npm --prefix frontend run build"
  },
  "keywords": [
    "agendamix",
    "react",
    "nodejs",
    "mysql",
    "express"
  ],
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
